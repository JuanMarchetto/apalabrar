{
  "name": "@apalabrar/app",
  "version": "0.0.0",
  "private": true,
  "description": "Apalabrar — browser app shell (Solid + Vite).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "coverage:check": "vitest run --coverage --coverage.thresholds.lines=85 --coverage.thresholds.branches=75",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "@apalabrar/editor-bridge": "workspace:*",
    "@apalabrar/ui": "workspace:*",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.5.0",
    "@vitest/coverage-v8": "^3.0.0",
    "happy-dom": "^15.7.0",
    "tailwindcss": "^4.0.0-beta.4",
    "@tailwindcss/postcss": "^4.0.0-beta.4",
    "postcss": "^8.4.47",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.10.2",
    "vitest": "^3.0.0"
  }
}
