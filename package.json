{
  "name": "apalabrar",
  "version": "0.0.0",
  "private": true,
  "description": "Apalabrar — browser-native academic document editor (Rust + WASM core, Solid.js shell).",
  "license": "MIT",
  "author": "Juan Patricio Marchetto <juanpatriciomarchetto@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/apalabrar/apalabrar.git"
  },
  "homepage": "https://apalabr.ar",
  "type": "module",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev --filter=@apalabrar/app",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:a11y": "turbo run test:a11y",
    "lint": "turbo run lint",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "typecheck": "turbo run typecheck",
    "e2e": "pnpm --filter @apalabrar/tests-e2e test:e2e",
    "e2e:ci": "pnpm --filter @apalabrar/tests-e2e test:e2e:ci",
    "coverage": "turbo run coverage",
    "coverage:check": "turbo run coverage:check",
    "mutants": "cargo mutants --workspace",
    "size-limit": "turbo run size-limit",
    "license-check": "license-checker --production --summary",
    "clean": "turbo run clean && rm -rf node_modules .turbo target",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@size-limit/file": "^12.1.0",
    "@types/node": "^22.7.0",
    "dprint": "^0.47.0",
    "eslint": "^9.12.0",
    "eslint-plugin-solid": "^0.14.3",
    "globals": "^15.0.0",
    "lefthook": "^1.7.18",
    "license-checker": "^25.0.1",
    "size-limit": "^12.1.0",
    "turbo": "^2.1.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.10.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "typescript": ">=5.6"
      }
    }
  }
}
